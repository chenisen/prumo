{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "A reviewer's finding",
  "description": "Every reviewer's output contract. The rule 'propose no fix for §A' is VALIDATION here, not a request to the model.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "reviewer",
    "severity",
    "class",
    "claim",
    "evidence",
    "consequence",
    "form",
    "diff_verifiable",
    "status",
    "attributable"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[A-Z]{2,4}-[0-9]{1,3}$"
    },
    "reviewer": {
      "type": "string"
    },
    "severity": {
      "enum": [
        "critical",
        "required",
        "nit",
        "optional",
        "fyi"
      ]
    },
    "class": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[AB](10|[1-9])$",
      "description": "a class de guardrail que este finding toca, ou null"
    },
    "claim": {
      "type": "string",
      "minLength": 10
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "description": "literal: arquivo e linha. Achado sem evidência não é finding.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "file"
        ],
        "properties": {
          "file": {
            "type": "string"
          },
          "line": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1
          },
          "snippet": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "consequence": {
      "type": "string",
      "minLength": 10,
      "description": "o que acontece neste código, não em tese"
    },
    "form": {
      "type": [
        "string",
        "null"
      ],
      "description": "the shape of the fix; MUST be null when the class belongs to §A"
    },
    "diff_verifiable": {
      "type": "boolean"
    },
    "attributable": {
      "type": "boolean",
      "description": "false = o finding é do projeto, não desta mudança; não bloqueia"
    },
    "status": {
      "enum": [
        "proposed",
        "confirmed",
        "refuted",
        "uncertain"
      ]
    },
    "categoria_owasp": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "class": {
            "type": "string",
            "pattern": "^A"
          }
        },
        "required": [
          "class"
        ]
      },
      "then": {
        "properties": {
          "form": {
            "type": "null"
          }
        }
      },
      "$comment": "§A é decisão humana: o harness descreve a pergunta e as portas, nunca a correção."
    }
  ]
}
