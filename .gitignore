__pycache__/
*.pyc
# The configuration belongs to each installation, never to the repository: versioning it
# would publish one team's paths and URLs inside everybody's tool. The contract is the
# .example.
/prumo.yml
# The tree the suite uses as a fake target.
/scripts/tests/tree/

# Tool cache, never versioned.
.pytest_cache/

# Run state, never source. `review.py prepare` creates it and `conclude` removes it; a
# copy swept into a commit by a run that had a review open blocks push and commit for
# everybody who checks the repo out, until it expires four hours later.
# Run state, never source. The pattern is UNANCHORED on purpose: the marker is written
# next to `CLAUDE_PROJECT_DIR` or the cwd, so a review launched from inside this
# repository drops it under `scripts/.claude/` — which the old root-anchored pattern did
# not match, and one `git add -A` later it was committed. The hygiene test caught it; the
# ignore should have.
**/.claude/.task-review-ativo

# An installation's own facts, which are never the method's: the profiles of somebody's
# repositories, the reports a run produced, and anything carrying a VALUE rather than a
# name. `scripts/hygiene.py` fails them if they reach a commit anyway.
/profiles/
/reports/
runs.jsonl
.env
*.env
